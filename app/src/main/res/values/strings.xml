    <!-- MainActivity -->
    <string name="steps_title">Cara pakai</string>
    <string name="steps_body">1. Tekan \"Aktifkan keyboard\" lalu nyalakan USB Serial Keyboard.\n2. Colokkan perangkat serial lewat kabel OTG.\n3. Buka kolom input di aplikasi mana pun, lalu tekan \"Pilih keyboard\" dan pilih USB Serial Keyboard.\n4. Izinkan akses USB saat diminta. Data serial akan diketik otomatis.</string>
